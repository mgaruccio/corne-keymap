/* Generated by scripts/generate-corne-keymap.py; edit layout.json instead. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    behaviors {
        outside_mod: outside_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Outside Mod-Tap";
        };
        space_cadet: space_cadet {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
            display-name = "Space Cadet";
        };
        thumb_lt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Thumb Layer-Tap";
        };
        esc_lt: escape_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
            display-name = "Escape Layer-Tap";
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            display-name = "Base";
            bindings = <
                &esc_lt 2 ESC  &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P  &outside_mod LEFT_ALT EQUAL
                &outside_mod LEFT_GUI BSPC  &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &outside_mod LEFT_CONTROL GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &outside_mod RIGHT_CONTROL MINUS
                &space_cadet LSHFT LPAR  &thumb_lt 1 BSPC  &kp TAB    &kp RET  &thumb_lt 1 SPACE  &space_cadet RSHFT RPAR
            >;
        };
        layer_1 {
            display-name = "Navigation";
            bindings = <
                &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp INS  &trans
                &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
                &trans  &kp LALT  &kp LBKT  &kp RBKT  &kp BSLH  &kp DEL    &kp LC(LEFT)  &kp LC(HOME)  &kp LC(END)  &kp LC(RIGHT)  &kp DEL  &trans
                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
        layer_2 {
            display-name = "Numbers / Utilities";
            bindings = <
                &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp BSPC  &kp N7  &kp N8  &kp N9  &kp FSLH  &kp EQUAL
                &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &kp TAB  &kp N4  &kp N5  &kp N6  &kp STAR  &outside_mod LEFT_ALT PLUS
                &trans  &kp F11  &kp F12  &bt BT_SEL 0  &bt BT_NXT  &studio_unlock    &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT  &trans
                &trans  &trans  &trans    &trans  &kp N0  &trans
            >;
        };
    };
};
